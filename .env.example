# Supabase – values from `npx supabase status` locally, or Project Settings → API Keys in the cloud
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only – bypasses RLS, never expose to the browser
SUPABASE_SECRET_KEY=sb_secret_...

# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes every stored API key unreadable.
KEY_ENCRYPTION_SECRET=

# Used for magic-link redirects when the request has no Origin header
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Cron sends it as a bearer token to /api/cron/keepalive (keeps the free Supabase project awake)
CRON_SECRET=

# Shown in the footer and the privacy policy
NEXT_PUBLIC_CONTACT_EMAIL=
